# ============================================================
# Configuración de la simulación de balanceo de carga
# Copiar este archivo como .env y modificar según necesidad:
#   copy .env.example .env
# ============================================================

# Número de tareas a simular
NUM_TAREAS=100

# Número de servidores
NUM_SERVIDORES=4

# Rango de duración de las tareas (en unidades de tiempo)
DURACION_MIN=1
DURACION_MAX=10

# Semilla para reproducibilidad del generador de tareas
SEMILLA=42

# Intervalo medio de llegada entre tareas.
# Con duración media (1 + 10) / 2 = 5.5 y capacidad 1 por servidor:
# normal: rho = 5.5 / (4 * 2) = 68.75 %;
# con un servidor menos: rho = 5.5 / (3 * 2) = 91.67 %.
# Se elige 2 para mantener normal en 60-70 % y el escenario C cerca de 90 %.
# En B, la capacidad total es 3.5: rho = 5.5 / (3.5 * 2) = 78.57 %.
# B y A no pueden alcanzar respectivamente 90 % y 60-70 % con un mismo
# intervalo de llegada: la capacidad de B es 87.5 % de la normal.
INTERVALO_LLEGADA=2

# Umbral de sobrecarga: carga estimada máxima de un servidor.
# La carga se define como (trabajo_pendiente / capacidad), es decir,
# el tiempo estimado para vaciar la cola. Si supera este valor,
# el servidor se marca como SOBRECARGADO y deja de recibir tareas
# hasta que su carga baje.
# La carga está expresada en unidades de trabajo/velocidad (tiempo de cola
# estimado). 12 equivale a algo más de dos tareas promedio por servidor,
# por encima del trabajo medio de una ronda normal, y permite detectar
# acumulaciones sin bloquear permanentemente el sistema.
UMBRAL_SOBRECARGA=12

# Número de tarea asignada tras la cual un servidor falla (escenario C).
# Tras asignar esta cantidad de tareas, el servidor indicado cae.
TAREA_FALLA=50

# ID del servidor que falla en el escenario C (0-indexado)
SERVIDOR_FALLA=2

# ID del servidor lento en el escenario B (0-indexado)
SERVIDOR_LENTO=2

# Capacidad reducida del servidor lento en el escenario B.
# Un valor de 0.5 significa que procesa a la mitad de velocidad.
CAPACIDAD_REDUCIDA=0.5

# Número de conjuntos de tareas/ejecuciones por estrategia. Las tres
# estrategias usan los mismos conjuntos para comparar promedio y desviación.
REPETICIONES=30
